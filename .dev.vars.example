# ==================== 本地开发配置示例 ====================
# 复制此文件为 .dev.vars 并填入你的真实值（.dev.vars 已被 .gitignore 排除）
# 用于 wrangler dev 本地调试

ADMIN_BOT_TOKEN = "你的管理Bot Token"
STORE_BOT_TOKEN = "你的前台Bot Token"
ADMIN_ID = "你的Telegram数字ID"
DEFAULT_UPSTREAM_URL = "你的默认上游订阅链接"

# 可选：对外门户地址（默认自动用请求域名）
# STORE_ORIGIN = "https://你的域名.com"
# 可选：前台 Bot 用户名（分销深链用）
# STORE_BOT_USERNAME = "你的前台bot用户名"
# 可选：Webhook 安全校验密钥
# WEBHOOK_SECRET = "随机字符串"
# 可选：/setup-webhooks 鉴权密钥
# SETUP_KEY = "随机字符串"
