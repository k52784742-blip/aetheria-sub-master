# ==================== VPS 部署环境变量模板 ====================
# 复制此文件为 .env 并填入你的真实值（.env 已被 .gitignore 排除）
# 然后运行：node server.js

# 后台私密管理 Bot Token（@BotFather 获取）
ADMIN_BOT_TOKEN = "你的管理Bot Token"

# 前台公开售卖 Bot Token（@BotFather 获取）
STORE_BOT_TOKEN = "你的前台Bot Token"

# 管理员专属 Telegram 数字 ID（@userinfobot 获取）
ADMIN_ID = "你的Telegram数字ID"

# 默认上游订阅链接（可后续用 /addurl 添加更多）
DEFAULT_UPSTREAM_URL = "你的默认上游链接"

# 可选：Webhook 安全校验密钥（防伪造请求）
# WEBHOOK_SECRET = "随机字符串"

# 可选：服务监听端口（默认 8787）
# PORT = 8787
